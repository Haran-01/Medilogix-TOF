{
  "name": "medilogix-tof",
  "version": "0.1.0",
  "private": true,
  "description": "Private desktop serial capture and review for the Medilogix TOF instrument.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.medilogix.tof",
    "productName": "Medilogix TOF",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "docs/references/device-sample.csv",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
