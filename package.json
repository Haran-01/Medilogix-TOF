{
  "name": "medilogix-tof",
  "version": "0.1.0",
  "private": true,
  "description": "Private desktop serial capture and review for the Medilogix TOF instrument.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "db:migrate": "node scripts/apply-supabase-migration.js",
    "package:win": "electron-builder --win nsis",
    "build:mobile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-mobile-viewer.ps1"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "pg": "^8.23.1"
  },
  "build": {
    "appId": "com.medilogix.tof",
    "productName": "Medilogix TOF",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      ".env",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/medilogix-symbol.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^16.6.1"
  },
  "author": "MedilogiX"
}
